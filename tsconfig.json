{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@assets/*": ["./assets/*"],
      "@src/*": ["./src"],
      "@app/*": ["./src/app"],
      "@db/*": ["./src/app/db/*"],
      "@services/*": ["./src/app/services/*"],
      "@components/*": ["./src/app/components/*"],
      "@/assets/*": ["./assets/*"],
      "@lib/*": ["./src/app/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app.d.ts",
    "nativewind-env.d.ts"
  ]
}
