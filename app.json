{
  "expo": {
    "name": "On and On timer",
    "slug": "on-and-on-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon_512.png",
    "scheme": "onandontimer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app_icon_512.png",
      "bundleIdentifier": "com.anonymous.onandontimer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.onandontimer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app_icon_512.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/app_icon_512.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
